---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<div
  class="hero-blob hero-blob-main"
  style={`--blob-mask: url("${base}masks/hero-blob-main.png")`}
  aria-hidden="true"
></div>
<div
  class="hero-blob hero-blob-soft"
  style={`--blob-mask: url("${base}masks/hero-blob-soft.png")`}
  aria-hidden="true"
></div>
