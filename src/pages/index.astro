---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import HeroBlob from "../components/HeroBlob.astro";
import { workSections } from "../data/photos";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" }).format(date);
---

<Base title="CQ">
  <header class="hero" id="top">
    <HeroBlob />
    <nav>
      <a class="nav-name" href="#top">CQ</a>
      <div class="nav-links">
        <a href="#portfolio">Portfolio</a>
        <a href="#blog">Blog</a>
      </div>
    </nav>
    <div class="hero-text">
      <p class="eyebrow">Oil / Watercolor / Acrylic</p>
      <h1>Painting what<br /><em>machines cannot feel</em></h1>
    </div>
  </header>

  <main>
    <section class="section" id="portfolio">
      <p class="section-label">Selected works</p>
      <div class="work-tabs" aria-label="Artwork sections">
        {workSections.map((section) => (
          <a href={`#${section.id}`}>{section.label}</a>
        ))}
      </div>
      <div class="work-sections">
        {workSections.map((section) => (
          <section class="work-section" id={section.id} aria-labelledby={`${section.id}-title`}>
            <div class="work-section-header">
              <h2 id={`${section.id}-title`}>{section.label}</h2>
              <span class="meta">{section.meta}</span>
            </div>
            <div class="works-grid">
              {section.works.map((work) => (
                <article class:list={["work-card", work.size && `work-card--${work.size}`]}>
                  <button class="work-open" type="button" data-title={work.title} data-meta={work.meta} aria-label={`View ${work.title}`}>
                    {work.src ? <Image src={work.src} alt={work.alt} loading="lazy" /> : <div class="work-placeholder"></div>}
                    <span class="work-label">
                      <span class="work-title">{work.title}</span>
                      <span class="meta">{work.meta}</span>
                    </span>
                  </button>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <dialog class="work-lightbox" aria-label="Artwork detail">
      <button class="lightbox-close" type="button" aria-label="Close artwork detail">Close</button>
      <div class="lightbox-media-wrap">
        <img class="lightbox-media" alt="" />
      </div>
      <div class="lightbox-details">
        <h2 class="lightbox-title"></h2>
        <p class="lightbox-meta meta"></p>
      </div>
    </dialog>

    <section class="strip">
      <p class="strip-quote">"Capturing the moment the self dissolves into landscape."</p>
      <p class="strip-body">A decade of painting across oils, watercolor, and acrylics. Currently working on a first deliberate body of work from Patagonia.</p>
    </section>

    <section class="section blog" id="blog">
      <p class="section-label">Writing</p>
      <div class="blog-list">
        {posts.map((post, index) => (
          <article class="blog-item">
            <span class="meta">{String(index + 1).padStart(3, "0")}</span>
            <div>
              <a class="blog-title" href={`${base}blog/${post.id}/`}>{post.data.title}</a>
              <p class="blog-summary">{post.data.summary}</p>
            </div>
            <span class="meta post-date">{formatDate(post.data.date)}</span>
          </article>
        ))}
      </div>
    </section>
  </main>
</Base>

<script>
  const lightbox = document.querySelector(".work-lightbox");
  const lightboxImage = lightbox?.querySelector(".lightbox-media");
  const lightboxTitle = lightbox?.querySelector(".lightbox-title");
  const lightboxMeta = lightbox?.querySelector(".lightbox-meta");
  const closeButton = lightbox?.querySelector(".lightbox-close");

  document.querySelectorAll(".work-open").forEach((button) => {
    button.addEventListener("click", () => {
      const image = button.querySelector("img");
      if (!lightbox || !lightboxImage || !lightboxTitle || !lightboxMeta || !image) return;

      lightboxImage.src = image.currentSrc || image.src;
      lightboxImage.alt = image.alt;
      lightboxTitle.textContent = button.getAttribute("data-title") ?? "";
      lightboxMeta.textContent = button.getAttribute("data-meta") ?? "";
      lightbox.showModal();
      closeButton?.focus();
    });
  });

  closeButton?.addEventListener("click", () => lightbox?.close());
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) lightbox.close();
  });
</script>
